<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OsuCorn</AssemblyName>
    <RootNamespace>OsuCorn</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 字体必须以 Resource 编进程序集，Fonts.GetFontFamilies(pack URI) 才找得到。 -->
    <Resource Include="Fonts\*.ttf" />
    <!-- 授权文本跟着程序走（OFL 1.1 的要求）。 -->
    <None Update="Fonts\ATTRIBUTION.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fonts\OFL-Outfit.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- 预设跟程序放一起：这个工具本来就是「拷到哪都能用」的小东西。 -->
    <None Update="presets.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
