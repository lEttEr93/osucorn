<Window x:Class="OsuCorn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="osu! corn"
        Width="470" Height="640"
        MinWidth="430" MinHeight="420"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 卡片里的小标签：模式 / 键数 -->
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#2A3036" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏：和 Roam 一样，标题 + 右上角窗口按钮 -->
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="MinimizeButton" Content="—" Width="30" Padding="0,2" FontSize="12"
                        Click="MinimizeButton_Click" ToolTip="最小化" />
                <Button x:Name="CloseButton" Content="✕" Width="30" Padding="0,2" FontSize="12"
                        Margin="6,0,0,0" Click="CloseButton_Click" ToolTip="关闭" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="osu! corn" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Text="按模式自动切皮肤 / 流速" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- 当前状态：tosu 连上之后这里是活的 -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="当前状态" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="ConnectionText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="tosu 未连接" />
                </DockPanel>
                <TextBlock x:Name="StateText" Text="等游戏启动…" FontSize="12" Margin="0,4,0,0" />
                <TextBlock x:Name="DetailText" Text="" FontSize="10.5" Margin="0,2,0,0"
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 预设列表 -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="预设" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="PresetCountText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PresetList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="10,9" Margin="0,0,0,7">
                                <DockPanel>
                                    <Button Content="应用" DockPanel.Dock="Right" VerticalAlignment="Center"
                                            Padding="12,4" FontSize="11"
                                            Click="ApplyPresetButton_Click" Tag="{Binding}" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border Style="{StaticResource BadgeStyle}" Margin="8,0,6,0">
                                                <TextBlock Text="{Binding ModeBadge}" FontSize="10"
                                                           Foreground="{StaticResource SecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- 底部：最近一条日志 -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="日志" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="LogText" Text="就绪" FontSize="10.5" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10.5"
                       Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="只通过 osu! 自己的快捷键操作，不改任何配置文件" FontSize="10.5"
                       Foreground="{StaticResource MutedTextBrush}" />
        </DockPanel>
    </Grid>
</Window>
