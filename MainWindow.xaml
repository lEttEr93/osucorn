<Window x:Class="OsuCorn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="osu! corn"
        Width="470" Height="660"
        MinWidth="430" MinHeight="460"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 预设 chip：选中（启用中）时用强调色 -->
        <Style x:Key="PresetChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="11,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#1A1014" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表格的一行：mania 给键数下拉框，其它模式显示固定标签 -->
        <DataTemplate x:Key="ProfileRowTemplate">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="9,7" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>

                    <!-- mania：自己挑键数（含「其它键数」兜底） -->
                    <ComboBox Grid.Column="0" ItemsSource="{Binding KeyOptions}" 
                              SelectedValuePath="Keys" SelectedValue="{Binding KeysForCombo, Mode=TwoWay}"
                              FontSize="11.5" Padding="6,2" Tag="{Binding}"
                              SelectionChanged="ProfileKeys_SelectionChanged"
                              Visibility="{Binding IsMania, Converter={StaticResource BoolToVis}}"
                              ToolTip="这个键数用这套皮肤 / 流速">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="11.5" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- 其它模式：固定标签 -->
                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryBrush}"
                               Visibility="{Binding IsMania, Converter={StaticResource InverseBoolToVis}}" />

                    <TextBox Grid.Column="1" Text="{Binding Skin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             FontSize="11" Padding="6,3" Tag="{Binding}"
                             LostFocus="ProfileField_LostFocus"
                             ToolTip="皮肤名，必须和 osu! 里显示的一致；留空 = 这行不动皮肤" />
                    <Button Grid.Column="2" Content="取当前" FontSize="10.5" Padding="7,3" Margin="6,0"
                            VerticalAlignment="Center" Tag="{Binding}" Click="UseCurrentButton_Click"
                            ToolTip="把这一行填成 osu! 现在的皮肤 / 流速（皮肤名太长时用它）" />
                    <TextBox Grid.Column="3" Text="{Binding ScrollSpeedText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             FontSize="11" Padding="6,3" Tag="{Binding}"
                             LostFocus="ProfileField_LostFocus"
                             IsEnabled="{Binding SupportsScrollSpeed}"
                             ToolTip="mania 流速 1–40，整数档；留空 = 这行不动流速" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏：和 Roam 一样，标题 + 右上角窗口按钮 -->
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="MinimizeButton" Content="—" Width="30" Padding="0,2" FontSize="12"
                        Click="MinimizeButton_Click" ToolTip="最小化" />
                <Button x:Name="CloseButton" Content="✕" Width="30" Padding="0,2" FontSize="12"
                        Margin="6,0,0,0" Click="CloseButton_Click" ToolTip="关闭" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="osu! corn" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Text="按模式自动切皮肤 / 流速" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- 当前状态 -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="当前状态" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="ConnectionText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="tosu 未连接" />
                </DockPanel>
                <TextBlock x:Name="StateText" Text="等游戏启动…" FontSize="12" Margin="0,4,0,0" />
                <TextBlock x:Name="DetailText" Text="" FontSize="10.5" Margin="0,2,0,0"
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 预设：多套，其中一套启用中（自动匹配模式，不需要手动挑行） -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button x:Name="AddPresetButton" Content="＋ 添加预设" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Padding="10,3" FontSize="11"
                        Click="AddPresetButton_Click" ToolTip="新建一套空预设（5 行模式配置）" />
                <Button x:Name="DeletePresetButton" Content="删除" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Padding="10,3" FontSize="11" Margin="0,0,6,0"
                        Click="DeletePresetButton_Click" ToolTip="删除当前这套预设" />
                <TextBlock Text="预设" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="0,0,10,0" />
            </DockPanel>
            <ItemsControl x:Name="PresetChips">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Content="{Binding Name}" Style="{StaticResource PresetChipStyle}"
                                     GroupName="presets" Tag="{Binding}"
                                     Checked="PresetChip_Checked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- 配置表：这套预设里的 5 行，由 corn 自动按模式/键数挑选 -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock x:Name="ProfilesHeader" Text="配置（自动匹配当前模式，不用手动选）"
                           FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <!-- 列头：告诉用户右边几格分别是皮肤名、取当前、流速 -->
            <Grid DockPanel.Dock="Top" Margin="9,0,9,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="模式" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="1" Text="皮肤（留空 = 不动）" FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="3" Text="流速" FontSize="10" Margin="6,0,0,0"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ProfileList" ItemTemplate="{StaticResource ProfileRowTemplate}" />
            </ScrollViewer>
        </DockPanel>

        <!-- 底部：最近一条日志 -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="日志" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="LogText" Text="就绪" FontSize="10.5" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,8,0,0">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10.5"
                       Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="只通过 osu! 自己的快捷键操作，不改任何配置文件" FontSize="10.5"
                       Foreground="{StaticResource MutedTextBrush}" />
        </DockPanel>
    </Grid>
</Window>
